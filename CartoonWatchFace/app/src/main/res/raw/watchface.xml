            <Compare expression="is_pm">
                <PartText x="320" y="220" width="45" height="34" alpha="255">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                    <Text align="LEFT">
                        <Font family="google_sans_bold" size="24" color="[CONFIGURATION.themeColor.1]">
